{
  "name": "dataanalyserservice",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run build:clean && npm run build:copy",
    "build:clean": "rm -rf dist ",
    "build:copy": "mkdir -p dist && cp *.js dist/ && cp package*.json dist/",
    "prebuild": "npm run test",
    "dev": "nodemon index.js"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.0"
  }
}
