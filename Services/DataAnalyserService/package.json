{
  "name": "dataanalyserservice",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run build:clean && npm run build:copy",
    "build:clean": "rm -rf dist ",
    "build:copy": "mkdir -p dist && cp *.js dist/ && cp package*.json dist/",
    "prebuild": "npm run test",
    "dev": "nodemon index.js"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "currency-codes": "^2.1.0",
    "moment-timezone": "^0.5.43",
    "validator": "^13.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.0"
  }
}
